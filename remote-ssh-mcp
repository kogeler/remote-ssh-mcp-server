#!/usr/bin/env bash

set -euo pipefail

entry_point_name='remote-ssh-mcp.py'

repository_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
venv_dir="${repository_dir}/venv-runtime"
venv_python="${venv_dir}/bin/python"
requirements_file="${repository_dir}/requirements.txt"
requirements_state="${venv_dir}/.requirements.txt"
entry_point="${repository_dir}/${entry_point_name}"

if [[ ! -f "${requirements_file}" ]]; then
    printf 'Requirements file is missing: %s\n' "${requirements_file}" >&2
    exit 1
fi

if [[ ! -x "${entry_point}" ]]; then
    printf 'Entry point is missing or not executable: %s\n' "${entry_point}" >&2
    exit 1
fi

if [[ ! -x "${venv_python}" ]]; then
    printf 'Runtime environment is not installed; run: make runtime-venv\n' >&2
    exit 1
fi

if [[ ! -f "${requirements_state}" ]] ||
    ! cmp -s "${requirements_file}" "${requirements_state}"; then
    printf 'Runtime environment is stale; run: make runtime-venv\n' >&2
    exit 1
fi

exec "${venv_python}" "${entry_point}" "$@"
