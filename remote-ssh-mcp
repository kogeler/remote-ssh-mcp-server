#!/usr/bin/env bash

set -euo pipefail

repository_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
venv_dir="${repository_dir}/venv-runtime"
venv_python="${venv_dir}/bin/python"
requirements_file="${repository_dir}/requirements.txt"
requirements_state="${venv_dir}/.requirements.txt"
version_file="${repository_dir}/.version"
version_state="${venv_dir}/.version"

if [[ ! -f "${requirements_file}" ]] || [[ ! -f "${version_file}" ]]; then
    printf 'Project runtime metadata is missing\n' >&2
    exit 1
fi

if [[ ! -x "${venv_python}" ]]; then
    printf 'Runtime environment is not installed; run: make runtime-venv\n' >&2
    exit 1
fi

if [[ ! -f "${requirements_state}" ]] ||
    [[ ! -f "${version_state}" ]] ||
    ! cmp -s "${requirements_file}" "${requirements_state}" ||
    ! cmp -s "${version_file}" "${version_state}"; then
    printf 'Runtime environment is stale; run: make runtime-venv\n' >&2
    exit 1
fi

if ! "${venv_python}" -I -c \
    'import importlib.metadata, pathlib, remote_ssh_mcp, ssh_wrapper, sys; expected = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").strip(); assert remote_ssh_mcp.__version__ == expected; assert importlib.metadata.version("remote-ssh-mcp") == expected; assert importlib.metadata.version("ssh-wrapper") == "0.1.0"' \
    "${version_file}" \
    >/dev/null 2>&1; then
    printf 'Runtime environment is invalid; run: make runtime-venv\n' >&2
    exit 1
fi

exec "${venv_python}" -I -m remote_ssh_mcp "$@"
