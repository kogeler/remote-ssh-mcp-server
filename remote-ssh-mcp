#!/usr/bin/env bash

set -euo pipefail

entry_point_name='remote-ssh-mcp.py'

repository_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
venv_dir="${repository_dir}/venv"
activation_file="${venv_dir}/bin/activate"
venv_python="${venv_dir}/bin/python"
requirements_file="${repository_dir}/requirements.txt"
requirements_state="${venv_dir}/.requirements.txt"
entry_point="${repository_dir}/${entry_point_name}"

if [[ ! -f "${requirements_file}" ]]; then
    printf 'Requirements file is missing: %s\n' "${requirements_file}" >&2
    exit 1
fi

if [[ ! -x "${entry_point}" ]]; then
    printf 'Entry point is missing or not executable: %s\n' "${entry_point}" >&2
    exit 1
fi

if [[ ! -x "${venv_python}" || ! -r "${activation_file}" ]]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf 'Python 3 is required to create the virtual environment.\n' >&2
        exit 1
    fi

    printf 'Creating virtual environment: %s\n' "${venv_dir}" >&2
    if ! python3 -m venv "${venv_dir}"; then
        printf 'Failed to create virtual environment: %s\n' "${venv_dir}" >&2
        exit 1
    fi
fi

if [[ ! -f "${requirements_state}" ]] ||
    ! cmp -s "${requirements_file}" "${requirements_state}"; then
    printf 'Installing dependencies from: %s\n' "${requirements_file}" >&2
    if ! "${venv_python}" -m pip install --requirement "${requirements_file}"; then
        printf 'Dependency installation failed; it will be retried on the next run.\n' >&2
        exit 1
    fi
    cp -- "${requirements_file}" "${requirements_state}"
fi

# shellcheck disable=SC1090
source "${activation_file}"
exec "${entry_point}" "$@"
